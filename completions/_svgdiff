#compdef svgdiff

_svgdiff() {
  _arguments \
    '1:before SVG:_files -g "*.svg"' \
    '2:after SVG:_files -g "*.svg"' \
    '--width[comparison viewport width in CSS pixels]:positive integer:' \
    '--height[comparison viewport height in CSS pixels]:positive integer:' \
    '--max-checkpoints[optional deterministic computation budget]:positive integer:' \
    '--perceptual-background[record one explicit opaque deterministic sRGB background]:color:' \
    '--flip-pixels-per-degree[request LDR-FLIP with supported pixels per degree]:pixels per degree:' \
    '--flip-error-threshold[report FLIP area above an explicit error threshold]:FLIP error threshold:' \
    '*--before-resource[supply one before-side raster resource]:resource JSON:' \
    '*--after-resource[supply one after-side raster resource]:resource JSON:' \
    '--output[write JSON to a file]:output file:_files' \
    '--html[write the self-contained HTML report]:HTML file:_files' \
    '--agent-json[emit whitespace-free canonical JSON]' \
    '--help[show command help]' \
    '--version[show component versions]'
}

_svgdiff "$@"
