  hierarchy_index : Int
  attributes : Array[PatternAttributeSource]
  href_fact : @model.DeclaredVisualFact?
  mut has_non_descriptive_child : Bool
}

pub(all) struct UnsupportedEmbeddedRasterColor {
  source_kind : String
  media_type : String
  encoding : String
  encoded_bytes : Int
  encoded_sha256 : String
  width : Int
  height : Int
  diagnostic_code : String
  detail : String
}

