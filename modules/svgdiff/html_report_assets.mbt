///|
fn html_report_styles() -> String {
  let styles =
    #|:root{color-scheme:light;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:#f2f5f3;color:#18231e;--ink:#18231e;--muted:#647069;--line:#d8dfda;--panel:#fff;--accent:#176b4d;--accent-soft:#e2f2eb;--warning:#8a5200;--warning-soft:#fff2d8;--magenta:#d0008b;--yellow:#d5a900;--blue:#0878d1;--orange:#dd6800}*{box-sizing:border-box}body{margin:0}.layout{display:grid;grid-template-columns:minmax(0,1fr) minmax(500px,44vw);height:100vh}.visuals{padding:18px;overflow:auto}.visual-header{display:flex;align-items:flex-start;justify-content:space-between;gap:14px;margin-bottom:12px}.visual-header h1{font-size:18px;margin:0}.visual-header p{font-size:12px;color:var(--muted);margin:4px 0 0}.view-controls{display:flex;align-items:center;gap:5px;flex-wrap:wrap;justify-content:flex-end}.view-controls button,.small-button,.locate,.group-nav,.filter-clear,.load-more{border:1px solid #bcc7c0;background:#fff;color:var(--ink);border-radius:6px;padding:6px 8px;font-size:11px;cursor:pointer}.view-controls button:hover,.small-button:hover,.locate:hover,.group-nav:hover,.filter-clear:hover,.load-more:hover{border-color:var(--accent)}#zoom-value{font:11px ui-monospace,SFMono-Regular,Menlo,monospace;min-width:40px;text-align:center}.preview-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.preview h2{font-size:12px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);margin:0 0 6px}.canvas{position:relative;background-color:#fafafa;background-image:linear-gradient(45deg,#e9eeeb 25%,transparent 25%),linear-gradient(-45deg,#e9eeeb 25%,transparent 25%),linear-gradient(45deg,transparent 75%,#e9eeeb 75%),linear-gradient(-45deg,transparent 75%,#e9eeeb 75%);background-size:16px 16px;background-position:0 0,0 8px,8px -8px,-8px 0;border:1px solid #c9d2cc;border-radius:10px;overflow:hidden;aspect-ratio:var(--canvas-ratio);box-shadow:0 3px 16px #24352c0c}.difference-canvas{background:#000;background-image:none}.difference-status{position:absolute;inset:0;z-index:2;display:grid;place-items:center;padding:16px;background:#000;color:#fff;text-align:center;font:11px ui-monospace,SFMono-Regular,Menlo,monospace}.difference-status[hidden]{display:none}.difference-status.error{background:#25130d;color:#ffd9ca}.preview-content{position:absolute;inset:0;transform-origin:0 0;will-change:transform}.preview-content iframe,.preview-content canvas{display:block;width:100%;height:100%;border:0}.preview-content iframe{background:#fff}.preview-content canvas{background:#000;image-rendering:pixelated}.overlay{position:absolute;inset:0;pointer-events:none}.pan-shield{position:absolute;inset:0;z-index:3;cursor:grab;touch-action:none}.pan-shield.dragging{cursor:grabbing}.region{position:absolute}.region.observed{border:2px solid var(--magenta);background:transparent;box-shadow:0 0 0 1px #fff8 inset}.region.conservative{border:2px dashed var(--yellow);background:repeating-linear-gradient(45deg,#e4b80035 0 4px,transparent 4px 8px)}.region-label{position:absolute;left:0;top:0;transform:translateY(-100%);padding:2px 4px;border-radius:3px 3px 0 0;background:var(--magenta);color:white;font:9px ui-monospace,SFMono-Regular,Menlo,monospace;white-space:nowrap}.region.conservative .region-label{background:#8a6b00}.localization-legend{display:flex;gap:12px;flex-wrap:wrap;color:var(--muted);font-size:10px;margin-top:10px}.localization-legend i{display:inline-block;width:16px;height:9px;margin-right:4px;vertical-align:-1px}.localization-legend .observed{border:2px solid var(--magenta)}.localization-legend .conservative{border:2px dashed var(--yellow);background:#e4b80035}.localization-legend .before-footprint{border:2px solid var(--blue);opacity:.35}.localization-legend .after-footprint{border:2px solid var(--orange);opacity:.35}.selection-hidden{margin-top:12px;border:1px solid #e6bb66;background:var(--warning-soft);padding:9px;border-radius:7px;display:flex;align-items:center;gap:8px;font-size:11px}.selection-hidden[hidden]{display:none}.selection-hidden span{flex:1}.sidebar{background:var(--panel);border-left:1px solid var(--line);overflow:auto;padding:17px}.report-header{display:flex;align-items:flex-start;justify-content:space-between;gap:10px}.report-header h1{font-size:18px;margin:0}.summary{font-size:11px;color:var(--muted);margin:4px 0 0}.compatibility{border:1px solid #e3b95f;background:var(--warning-soft);color:var(--warning);border-radius:999px;padding:4px 7px;font-size:9px;white-space:nowrap}.section-title{font-size:13px;margin:17px 0 8px;color:#303d36}.callout{border:1px solid var(--line);border-radius:8px;background:#f8faf8;padding:9px;font-size:11px;color:#4f5b54;margin:7px 0}.callout.warning{border-color:#edc875;background:var(--warning-soft);color:var(--warning)}.overview-grid{display:grid;grid-template-columns:repeat(4,minmax(75px,1fr));gap:6px}.metric{border:1px solid #e0e6e2;border-radius:7px;padding:7px;background:#fbfcfb}.metric-label{font-size:9px;text-transform:uppercase;letter-spacing:.04em;color:#747f78}.metric-value{font-size:12px;margin-top:2px;word-break:break-word}.group-navigation{display:flex;gap:5px;flex-wrap:wrap;margin:8px 0}.impact-map-wrap{margin:10px 0 4px}.impact-map-title{display:flex;justify-content:space-between;gap:8px;font-size:10px;color:var(--muted)}.impact-map{height:105px;position:relative;border-left:1px solid #9aa79f;border-bottom:1px solid #9aa79f;margin:9px 8px 19px 29px;background:linear-gradient(135deg,transparent 49.5%,#dce3de55 50%)}.impact-map:before{content:"changed pixels";position:absolute;left:-40px;top:35px;transform:rotate(-90deg);font-size:9px;color:var(--muted)}.impact-map:after{content:"linear RGBA RMSE";position:absolute;right:0;bottom:-16px;font-size:9px;color:var(--muted)}.impact-point{position:absolute;width:12px;height:12px;border:2px solid white;border-radius:50%;background:var(--accent);box-shadow:0 0 0 1px var(--accent);transform:translate(-50%,50%);cursor:pointer;padding:0;color:#fff;font-size:0}.impact-point.cluster{width:18px;height:18px;font:700 8px ui-monospace,SFMono-Regular,Menlo,monospace}.impact-point:hover,.impact-point:focus{transform:translate(-50%,50%) scale(1.3);outline:none}.filters{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px;padding:9px;border:1px solid var(--line);border-radius:8px;background:#fafcfa}.filters label{display:grid;gap:3px;font-size:9px;text-transform:uppercase;letter-spacing:.04em;color:var(--muted)}.filters input,.filters select{width:100%;min-width:0;border:1px solid #bac5be;border-radius:6px;background:#fff;color:var(--ink);padding:6px;font-size:11px}.filter-footer{grid-column:1/-1;display:flex;align-items:center;gap:8px}.filter-count{margin-left:auto;color:var(--muted);font-size:10px}.outcome-group{margin:0 0 14px;scroll-margin-top:8px}.group-header{display:flex;align-items:center;gap:7px;padding:8px 9px;border:1px solid var(--line);background:#eaf0ec;border-radius:8px 8px 0 0}.group-header h3{font-size:12px;margin:0;flex:1}.group-count{font-size:9px;color:var(--muted)}.load-more-wrap{border:1px solid var(--line);border-top:0;border-radius:0 0 8px 8px;padding:9px;text-align:center;background:#fafcfa}.event-card{border:1px solid var(--line);border-top:0;background:#fff;outline:none}.event-card:last-child{border-radius:0 0 8px 8px}.event-card.active{box-shadow:inset 3px 0 var(--accent);background:#fcfffd}.event-card.previewing{outline:2px solid #66a98e;outline-offset:-2px}.event-summary{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:8px;padding:10px 10px 8px;align-items:start}.event-identity{display:flex;align-items:center;gap:5px;flex-wrap:wrap}.event-identity strong{font-size:12px}.code{font:10px ui-monospace,SFMono-Regular,Menlo,monospace;color:var(--muted);word-break:break-word}.badges{display:flex;flex-wrap:wrap;gap:4px;margin-top:5px}.badge{font-size:9px;border-radius:999px;padding:2px 6px;background:#edf1ee;color:#46534c}.badge.nonzero{background:#ffe0ef;color:#8b005b}.badge.zero{background:#dff2e9;color:#195e46}.badge.not-computed,.badge.limited{background:var(--warning-soft);color:var(--warning)}.badge.frontier{background:#e8e7ff;color:#3730a3}.scan-row{display:grid;grid-template-columns:108px minmax(0,1fr);gap:7px;margin-top:6px;font-size:10px}.scan-label{color:var(--muted)}.event-actions{display:flex;gap:4px}.locate{padding:5px 7px}.atomic-list{margin:0 10px 9px 35px;border-left:2px solid #dce4df}.atomic-diff{display:grid;grid-template-columns:auto minmax(105px,.75fr) minmax(165px,1.35fr) minmax(130px,.9fr);gap:7px;align-items:center;padding:8px;border-top:1px solid #e5ebe7;font-size:10px;outline:none}.atomic-diff:first-child{border-top:0}.atomic-diff:hover,.atomic-diff:focus-within{background:#f4faf7}.diff-title{font-weight:650;word-break:break-word}.diff-source{font:10px ui-monospace,SFMono-Regular,Menlo,monospace;word-break:break-word}.relation-equivalent{color:#176043}.relation-different{color:#8d245a}.relation-indeterminate{color:var(--warning)}.direct-magnitude{color:#37453e}.shared-location{display:block;color:var(--muted);margin-top:3px}.warning-line{margin:0 10px 9px 35px;padding:7px 8px;background:var(--warning-soft);color:var(--warning);border-radius:6px;font-size:10px}.evidence{margin:0 10px 9px 35px;border:1px solid #dfe6e1;border-radius:7px;background:#fafcfb}.evidence>summary{cursor:pointer;padding:7px 8px;font-size:10px;font-weight:650}.evidence-body{padding:0 8px 8px;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:7px}.evidence-section{min-width:0;border-top:1px solid #dfe6e1;padding-top:7px}.evidence-section h4{font-size:9px;text-transform:uppercase;letter-spacing:.04em;color:#68746d;margin:0 0 4px}.atomic-evidence{margin:5px 0 0;grid-column:2/-1}.atomic-evidence>summary{font-size:10px;cursor:pointer;color:#3e4b44}.kv{width:100%;border-collapse:collapse;font:9px ui-monospace,SFMono-Regular,Menlo,monospace}.kv th,.kv td{text-align:left;vertical-align:top;border-top:1px solid #e8ede9;padding:3px;word-break:break-word}.kv th{width:42%;font-weight:500;color:#68736d}.fact-card,.diagnostic-card,.region-card{border:1px solid #e1e7e3;border-radius:5px;padding:5px;margin:4px 0;font-size:9px}.card-title{font-weight:650;word-break:break-word}.card-detail{color:#647069;margin-top:2px;word-break:break-word}.empty{font-size:10px;color:#77817b}.diagnostics-panel,.json-panel{border-top:1px solid var(--line);padding-top:11px;margin-top:17px}.diagnostics-panel>summary,.json-panel>summary{cursor:pointer;font-weight:650;font-size:12px}.raw-help{font-size:10px;color:var(--muted)}.raw-actions{display:flex;align-items:center;gap:6px}.raw-actions button{border:1px solid #bcc7c0;background:#fff;color:var(--ink);border-radius:6px;padding:5px 7px;font-size:10px;cursor:pointer}.raw-actions span{font-size:10px;color:var(--muted)}textarea{width:100%;height:330px;margin-top:7px;resize:vertical;border:1px solid var(--line);border-radius:6px;padding:9px;font:10px ui-monospace,SFMono-Regular,Menlo,monospace;background:#f7f9f7}.review-help{font-size:9px;color:var(--muted);margin:4px 0 0}.orphan-note{font-size:10px;color:var(--warning);padding:7px 9px;background:var(--warning-soft)}@media(max-width:1050px){.layout{grid-template-columns:1fr;height:auto}.visuals{min-height:42vh}.sidebar{border-left:0;border-top:1px solid var(--line)}.preview-content{will-change:auto}}@media(max-width:680px){.visuals,.sidebar{padding:12px}.preview-grid{grid-template-columns:1fr}.overview-grid{grid-template-columns:repeat(2,1fr)}.atomic-diff{grid-template-columns:auto 1fr}.atomic-diff>:nth-child(n+3){grid-column:2}.scan-row{grid-template-columns:1fr;gap:2px}.evidence-body{grid-template-columns:1fr}.filters{grid-template-columns:1fr}.filter-footer{grid-column:1}}
    #|.score-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:7px;margin-bottom:9px}.score-card{border:1px solid #d8e2dc;border-radius:9px;padding:10px 8px;background:linear-gradient(180deg,#fbfefc,#f3f8f5);min-width:0}.score-label{font-size:9px;text-transform:uppercase;letter-spacing:.045em;color:#68756e}.score-value{font-size:22px;line-height:1.05;font-weight:720;color:#124f3b;margin:6px 0 5px;white-space:nowrap}.score-value.unavailable{font-size:14px;color:var(--warning)}.score-detail{font-size:9px;color:var(--muted);line-height:1.35}@media(max-width:680px){.score-grid{grid-template-columns:1fr}.score-value{font-size:20px}}
    #|.effective-value{display:inline-block;margin-top:4px;padding:2px 6px;border-radius:999px;font:9px Inter,ui-sans-serif,system-ui,sans-serif;background:#edf1ee}.effective-value.relation-equivalent{color:#176043;background:#dff2e9}.effective-value.relation-different{color:#8d245a;background:#ffe0ef}.effective-value.relation-indeterminate{color:var(--warning);background:var(--warning-soft)}
    #|.event-details[hidden]{display:none}.details-toggle[aria-expanded="true"]{background:var(--accent-soft);border-color:var(--accent)}
  styles
}

///|
fn html_report_script() -> String {
  let script =
    #|window.SvgdiffReportInspector={mount(scope=document){const byId=id=>scope.querySelector(`#${id}`);
    #|const structuredReport=JSON.parse(byId('report-data').value);
    #|function inspectorView(value){const atomic=value.difference_groups.flatMap(group=>group.items.map(item=>({...item,domain:item.kind,source_before:item.source.before,source_after:item.source.after,computed_relation:{status:item.effective.relation,reason_code:item.effective.reason||'',diagnostic_ids:item.effective.limitation_ids||[]},magnitude:{...(item.magnitude||{})},evidence_layers:[],changed_fact_ids:[]})));const events=value.events.map(event=>({...event,primary_subject_id:event.subject,atomic_difference_ids:event.difference_ids,rendered_outcome:{status:event.outcome.status,reason_code:event.outcome.reason,magnitude:event.outcome.status==='computed'?{changed_pixels:event.outcome.changed_pixels,changed_pixel_fraction:event.outcome.changed_fraction,linear_premultiplied_rgba_rmse:event.outcome.linear_rgba_rmse}:undefined,isolated_subject:event.outcome.isolated_subject,perceptual_color:event.outcome.perceptual_color?{status:'computed',magnitude:event.outcome.perceptual_color}:undefined,perceptual_flip:event.outcome.perceptual_difference?{status:'computed',statistics:event.outcome.perceptual_difference}:undefined},difference_regions:event.regions.map(region=>({...region,source:region.kind==='observed'?'pixel_mask':'computed_bounds',css_x:region.bounds.x,css_y:region.bounds.y,css_width:region.bounds.width,css_height:region.bounds.height,cause_envelope:{guarantee:region.possible_causes.guarantee,coverage:region.possible_causes.coverage,fallback_scope:region.possible_causes.scope,candidate_changed_fact_ids:region.possible_causes.candidate_difference_ids||[],diagnostic_ids:region.possible_causes.limitation_ids||[]}}))}));const canvas=value.canvas;return{...value,profile:{viewport_width:value.comparison.viewport.width,viewport_height:value.comparison.viewport.height},canvas_outcome:{status:canvas.status,reason_code:canvas.reason,magnitude:canvas.status==='computed'?{changed_pixels:canvas.changed_pixels,changed_pixel_fraction:canvas.changed_fraction,linear_premultiplied_rgba_rmse:canvas.linear_rgba_rmse}:undefined,perceptual_flip:typeof canvas.perceptual_difference==='number'?{status:'computed',canvas_mean:canvas.perceptual_difference}:{status:'not_computed'}},atomic_differences:atomic,changed_facts:atomic.map(item=>({id:item.id,property:item.kind,before:item.source_before,after:item.source_after})),events,diagnostics:value.limitations.map(item=>({...item,subject_id:item.subject,affected_evidence_layers:item.affects}))}}
    #|const report=inspectorView(structuredReport);
    #|const overviewRoot=byId('overview');const root=byId('diffs');const diagnosticsRoot=byId('diagnostics');const overlays=[...scope.querySelectorAll('[data-overlay]')];const contents=[...scope.querySelectorAll('.preview-content')];const previewFrames=[...scope.querySelectorAll('.preview-content iframe')];const differenceCanvas=scope.querySelector('[data-difference-canvas]');const differenceStatus=scope.querySelector('[data-difference-status]');const selectionStatus=byId('selection-status');
    #|const diffsById=new Map(report.atomic_differences.map(value=>[value.id,value]));const factsById=new Map(report.changed_facts.map(value=>[value.id,value]));const diagnosticsById=new Map(report.diagnostics.map(value=>[value.id,value]));
    #|const EVENT_BATCH_SIZE=24;const state={selectedEvent:null,hoverEvent:null,atomicContext:null,reviewed:new Set(),eventLimits:new Map(),filters:{outcome:'all',family:'all',relation:'all',review:'all',search:''},view:{scale:1,x:0,y:0}};const itemByEvent=new Map();const atomicChecks=new Map();
    #|function node(tag,className,text){const value=document.createElement(tag);if(className)value.className=className;if(text!==undefined)value.textContent=String(text);return value}
    #|function previewSvgSource(frame){const parsed=new DOMParser().parseFromString(frame.srcdoc,'text/html');const svg=parsed.querySelector('svg');if(!svg)throw new Error('SVG preview source is unavailable');svg.setAttribute('width',String(report.profile.viewport_width));svg.setAttribute('height',String(report.profile.viewport_height));return new XMLSerializer().serializeToString(svg)}
    #|function loadSvgImage(source){return new Promise((resolve,reject)=>{const image=new Image();image.onload=()=>resolve(image);image.onerror=()=>reject(new Error('SVG preview could not be rasterized'));image.src=`data:image/svg+xml,${encodeURI(source).replace(/#/g,'%23')}`})}
    #|function rasterPixels(image,width,height){const canvas=document.createElement('canvas');canvas.width=width;canvas.height=height;const context=canvas.getContext('2d',{alpha:false});context.fillStyle='#fff';context.fillRect(0,0,width,height);context.drawImage(image,0,0,width,height);return context.getImageData(0,0,width,height).data}
    #|async function renderDifference(){const width=report.profile.viewport_width;const height=report.profile.viewport_height;differenceCanvas.width=width;differenceCanvas.height=height;differenceCanvas.dataset.state='rendering';differenceCanvas.setAttribute('aria-busy','true');differenceStatus.hidden=false;differenceStatus.classList.remove('error');differenceStatus.textContent='Rendering difference…';try{const images=await Promise.all(previewFrames.map(frame=>loadSvgImage(previewSvgSource(frame))));const before=rasterPixels(images[0],width,height);const after=rasterPixels(images[1],width,height);const context=differenceCanvas.getContext('2d',{alpha:false});const output=context.createImageData(width,height);for(let index=0;index<output.data.length;index+=4){output.data[index]=before[index]===after[index]?0:255;output.data[index+1]=before[index+1]===after[index+1]?0:255;output.data[index+2]=before[index+2]===after[index+2]?0:255;output.data[index+3]=255}context.putImageData(output,0,0);differenceCanvas.dataset.state='ready';differenceCanvas.setAttribute('aria-busy','false');differenceStatus.hidden=true}catch(error){const message=error.message||String(error);differenceCanvas.dataset.state='error';differenceCanvas.setAttribute('aria-busy','false');differenceCanvas.title=message;differenceStatus.classList.add('error');differenceStatus.textContent=`Difference unavailable: ${message}`}}
    #|function badge(text,className=''){return node('span',`badge ${className}`.trim(),text)}
    #|function section(title){const value=node('section','evidence-section');value.append(node('h4','',title));return value}
    #|function valueText(value){if(value===null||value===undefined)return'No value reported';if(typeof value==='object')return JSON.stringify(value);return String(value)}
    #|function formatNumber(value){if(typeof value!=='number')return valueText(value);if(value===0)return'0';const absolute=Math.abs(value);const rendered=absolute>=10000||absolute<0.001?value.toExponential(3):Number(value.toPrecision(4)).toString();return Number(rendered)===value?rendered:`≈${rendered}`}
    #|function formatPercent(value){if(typeof value!=='number')return'Not measured';if(value>0&&value*100<.01)return'<0.01%';return`${(value*100).toFixed(2)}%`}
    #|function scoreCard(label,value,detail,raw){const card=node('div','score-card');const rendered=node('div',`score-value ${typeof value==='number'?'':'unavailable'}`.trim(),formatPercent(value));card.append(node('div','score-label',label),rendered,node('div','score-detail',detail));card.title=typeof value==='number'?`${raw}: ${value}`:`${raw}: not measured`;return card}
    #|function renderCanvasScores(){const outcome=report.canvas_outcome||{};const magnitude=outcome.status==='computed'?outcome.magnitude:null;const flip=outcome.perceptual_flip?.status==='computed'?outcome.perceptual_flip:null;const total=report.profile.viewport_width*report.profile.viewport_height;const changedDetail=magnitude?`${magnitude.changed_pixels} / ${total} canvas pixels`:`${outcome.reason_code||'rendered evidence unavailable'}`;const grid=node('div','score-grid');grid.append(scoreCard('Changed area',magnitude?.changed_pixel_fraction,changedDetail,'canvas_outcome.magnitude.changed_pixel_fraction'),scoreCard('Linear RGBA error',magnitude?.linear_premultiplied_rgba_rmse,'Linear premultiplied RGBA RMSE','canvas_outcome.magnitude.linear_premultiplied_rgba_rmse'),scoreCard('Perceptual difference',flip?.canvas_mean,flip?'LDR-FLIP canvas mean':`${outcome.perceptual_flip?.reason_code||'FLIP unavailable'}`,'canvas_outcome.perceptual_flip.canvas_mean'));overviewRoot.append(grid)}
    #|function tableFor(object,empty='No values.'){const entries=Object.entries(object).filter(([,value])=>value!==undefined);if(entries.length===0)return node('div','empty',empty);const table=node('table','kv');for(const [key,value]of entries){const row=document.createElement('tr');row.append(node('th','',key),node('td','',valueText(value)));table.append(row)}return table}
    #|function domainFamily(domain){const prefix=String(domain).split('.')[0];return({presence:'Presence',geometry:'Geometry',transform:'Geometry',paint:'Paint',stroke:'Paint',compositing:'Compositing',effect:'Compositing',effects:'Compositing',filter:'Compositing',mask:'Compositing',clip:'Compositing',opacity:'Compositing',resource:'Resource',text:'Text',structure:'Structure'})[prefix]||domain}
    #|function eventOutcome(event){const outcome=event.rendered_outcome||{};if(outcome.status!=='computed'||!outcome.magnitude)return'not-computed';const magnitude=outcome.magnitude;const values=[magnitude.changed_pixels,magnitude.changed_pixel_fraction,magnitude.rgba8_rmse,magnitude.linear_premultiplied_rgba_rmse].filter(value=>typeof value==='number');if(values.length===0)return'not-computed';return values.some(value=>value!==0)?'nonzero':'zero'}
    #|function outcomeLabel(group){return group==='nonzero'?'Measured nonzero':group==='zero'?'Measured zero':'Not computed'}
    #|function eventDiffs(event){return(event.atomic_difference_ids||[]).map(id=>diffsById.get(id)).filter(Boolean)}
