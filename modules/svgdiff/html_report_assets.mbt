    #|function bindView(){byId('fit-selection').onclick=fitSelection;byId('fit-canvas').onclick=fitCanvas;byId('reset-view').onclick=fitCanvas;byId('zoom-in').onclick=()=>zoom(1.25);byId('zoom-out').onclick=()=>zoom(.8);for(const shield of scope.querySelectorAll('.pan-shield')){let drag=null;shield.addEventListener('pointerdown',value=>{drag={x:value.clientX,y:value.clientY};shield.setPointerCapture(value.pointerId);shield.classList.add('dragging')});shield.addEventListener('pointermove',value=>{if(!drag)return;state.view.x+=value.clientX-drag.x;state.view.y+=value.clientY-drag.y;drag={x:value.clientX,y:value.clientY};applyView()});shield.addEventListener('pointerup',()=>{drag=null;shield.classList.remove('dragging')});shield.addEventListener('pointercancel',()=>{drag=null;shield.classList.remove('dragging')})}}
