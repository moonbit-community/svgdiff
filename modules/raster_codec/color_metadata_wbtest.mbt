///|
test "PNG color metadata distinguishes sRGB, profiles, HDR, and depth" {
  let plain = inspect_png_color_metadata(
    b"\x89\x50\x4E\x47\x0D\x0A\x1A\x0A\x00\x00\x00\x0D\x49\x48\x44\x52\x00\x00\x00\x01\x00\x00\x00\x01\x08\x06\x00\x00\x00\x1F\x15\xC4\x89\x00\x00\x00\x00\x49\x45\x4E\x44\xAE\x42\x60\x82",
  )
  assert_eq(plain.width, 1)
  assert_eq(plain.height, 1)
  assert_true(plain.condition is SrgbCompatible)
  let srgb = inspect_png_color_metadata(
    b"\x89\x50\x4E\x47\x0D\x0A\x1A\x0A\x00\x00\x00\x0D\x49\x48\x44\x52\x00\x00\x00\x01\x00\x00\x00\x01\x08\x06\x00\x00\x00\x1F\x15\xC4\x89\x00\x00\x00\x01\x73\x52\x47\x42\x00\xAE\xCE\x1C\xE9\x00\x00\x00\x00\x49\x45\x4E\x44\xAE\x42\x60\x82",
  )
  assert_true(srgb.condition is SrgbCompatible)
  let icc = inspect_png_color_metadata(
    b"\x89\x50\x4E\x47\x0D\x0A\x1A\x0A\x00\x00\x00\x0D\x49\x48\x44\x52\x00\x00\x00\x01\x00\x00\x00\x01\x08\x06\x00\x00\x00\x1F\x15\xC4\x89\x00\x00\x00\x12\x69\x43\x43\x50\x70\x00\x00\x78\x9C\x2B\x28\xCA\x4F\xCB\xCC\x49\x05\x00\x0B\xFE\x02\xF2\x39\xD8\x40\x1C\x00\x00\x00\x00\x49\x45\x4E\x44\xAE\x42\x60\x82",
  )
  assert_true(icc.condition is EmbeddedColorProfile("png_iCCP"))
  let gamma = inspect_png_color_metadata(
    b"\x89\x50\x4E\x47\x0D\x0A\x1A\x0A\x00\x00\x00\x0D\x49\x48\x44\x52\x00\x00\x00\x01\x00\x00\x00\x01\x08\x06\x00\x00\x00\x1F\x15\xC4\x89\x00\x00\x00\x04\x67\x41\x4D\x41\x00\x00\xC3\x50\x00\x99\xB5\x34\x00\x00\x00\x00\x49\x45\x4E\x44\xAE\x42\x60\x82",
  )
  assert_true(gamma.condition is EmbeddedColorProfile("png_gAMA"))
  let srgb_gamma = inspect_png_color_metadata(
    b"\x89\x50\x4E\x47\x0D\x0A\x1A\x0A\x00\x00\x00\x0D\x49\x48\x44\x52\x00\x00\x00\x01\x00\x00\x00\x01\x08\x06\x00\x00\x00\x1F\x15\xC4\x89\x00\x00\x00\x04\x67\x41\x4D\x41\x00\x00\xB1\x8F\x0B\xFC\x61\x05\x00\x00\x00\x00\x49\x45\x4E\x44\xAE\x42\x60\x82",
  )
  assert_true(srgb_gamma.condition is SrgbCompatible)
  let srgb_chromaticities = inspect_png_color_metadata(
    b"\x89\x50\x4E\x47\x0D\x0A\x1A\x0A\x00\x00\x00\x0D\x49\x48\x44\x52\x00\x00\x00\x01\x00\x00\x00\x01\x08\x06\x00\x00\x00\x1F\x15\xC4\x89\x00\x00\x00\x20\x63\x48\x52\x4D\x00\x00\x7A\x26\x00\x00\x80\x84\x00\x00\xFA\x00\x00\x00\x80\xE8\x00\x00\x75\x30\x00\x00\xEA\x60\x00\x00\x3A\x98\x00\x00\x17\x70\x9C\xBA\x51\x3C\x00\x00\x00\x00\x49\x45\x4E\x44\xAE\x42\x60\x82",
  )
  assert_true(srgb_chromaticities.condition is SrgbCompatible)
  let hdr = inspect_png_color_metadata(
    b"\x89\x50\x4E\x47\x0D\x0A\x1A\x0A\x00\x00\x00\x0D\x49\x48\x44\x52\x00\x00\x00\x01\x00\x00\x00\x01\x08\x06\x00\x00\x00\x1F\x15\xC4\x89\x00\x00\x00\x04\x63\x49\x43\x50\x01\x10\x00\x01\x88\x97\x0B\x11\x00\x00\x00\x00\x49\x45\x4E\x44\xAE\x42\x60\x82",
  )
  assert_true(hdr.condition is HdrOrHighBitDepth("png_cICP_hdr"))
  let depth = inspect_png_color_metadata(
    b"\x89\x50\x4E\x47\x0D\x0A\x1A\x0A\x00\x00\x00\x0D\x49\x48\x44\x52\x00\x00\x00\x01\x00\x00\x00\x01\x10\x06\x00\x00\x00\x4F\x85\x18\xCA\x00\x00\x00\x00\x49\x45\x4E\x44\xAE\x42\x60\x82",
  )
  assert_true(depth.condition is HdrOrHighBitDepth("png_16_bit_samples"))
}

///|
test "JPEG color metadata distinguishes ICC and high precision" {
  let plain = inspect_jpeg_color_metadata(
    b"\xFF\xD8\xFF\xC0\x00\x0B\x08\x00\x01\x00\x01\x01\x01\x11\x00\xFF\xD9",
  )
  assert_eq(plain.width, 1)
  assert_eq(plain.height, 1)
  assert_true(plain.condition is SrgbCompatible)
  let icc = inspect_jpeg_color_metadata(
    b"\xFF\xD8\xFF\xE2\x00\x10\x49\x43\x43\x5F\x50\x52\x4F\x46\x49\x4C\x45\x00\x01\x01\xFF\xC0\x00\x0B\x08\x00\x01\x00\x01\x01\x01\x11\x00\xFF\xD9",
  )
  assert_true(icc.condition is EmbeddedColorProfile("jpeg_icc_app2"))
  let high_precision = inspect_jpeg_color_metadata(
    b"\xFF\xD8\xFF\xC1\x00\x0B\x0C\x00\x01\x00\x01\x01\x01\x11\x00\xFF\xD9",
  )
  assert_true(
    high_precision.condition is HdrOrHighBitDepth("jpeg_12_bit_samples"),
  )
}

///|
test "color metadata inspection rejects malformed containers" {
  try inspect_png_color_metadata(b"not png") catch {
    InvalidSignature(_) => ()
    _ => fail("expected invalid PNG signature")
  } noraise {
    _ => fail("expected invalid PNG signature")
  }
  try inspect_jpeg_color_metadata(b"\xFF\xD8\xFF\xE2\x00\x20") catch {
    CorruptData(_) => ()
    _ => fail("expected corrupt JPEG segment")
  } noraise {
    _ => fail("expected corrupt JPEG segment")
  }
}
