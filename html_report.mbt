///|
fn escape_html(value : String) -> String {
  value
  .replace_all(old="&", new="&amp;")
  .replace_all(old="<", new="&lt;")
  .replace_all(old=">", new="&gt;")
  .replace_all(old="\"", new="&quot;")
  .replace_all(old="'", new="&#39;")
}

///|
fn sandbox_document(source : String) -> String {
  escape_html(
    "<!doctype html><meta http-equiv='Content-Security-Policy' content=\"default-src 'none'; style-src 'unsafe-inline'\"><style>html,body{margin:0;width:100%;height:100%;overflow:hidden}svg{display:block;width:100%;height:100%}</style>\{source}",
  )
}

///|
/// Render a self-contained interactive HTML presentation of a report.
///
/// The original SVG sources are embedded as sandboxed preview documents. The
/// supplied Structured Report remains the sole source of classification,
/// ordering, magnitude, Difference Regions, and Diagnostics; this function
/// does not run comparison again.
pub fn render_html_report(
  before_svg : String,
  after_svg : String,
  report : StructuredReport,
) -> String {
  let report_json = escape_html(report.to_json_string())
  let before_document = sandbox_document(before_svg)
  let after_document = sandbox_document(after_svg)
  let width = report.profile.viewport_width
  let height = report.profile.viewport_height
  let html =
    $|<!doctype html>
    $|<html lang="en"><head><meta charset="utf-8">
    $|<meta name="viewport" content="width=device-width,initial-scale=1">
    $|<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; frame-src 'self'">
    $|<title>SVG Diff Report</title>
    $|<style>
    $|:root{color-scheme:light;font-family:ui-sans-serif,system-ui,sans-serif;background:#f5f6f8;color:#17191d}*{box-sizing:border-box}body{margin:0}.layout{display:grid;grid-template-columns:minmax(0,1fr) minmax(380px,500px);height:100vh}.visuals{padding:20px;display:grid;grid-template-columns:1fr 1fr;gap:16px;align-content:start;overflow:auto}.preview h2{font-size:14px;margin:0 0 8px}.canvas{position:relative;background:white;border:1px solid #d7d9de;border-radius:10px;overflow:hidden;aspect-ratio:\{width}/\{height};box-shadow:0 1px 2px rgba(17,24,39,.05)}iframe{display:block;width:100%;height:100%;border:0}.overlay{position:absolute;inset:0;pointer-events:none}.region{position:absolute;border:2px solid #e11d48;background:rgba(225,29,72,.16);box-shadow:0 0 0 1px white inset}.sidebar{background:white;border-left:1px solid #d7d9de;overflow:auto;padding:18px}.report-header{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}.report-header h1{font-size:18px;margin:0}.summary{font-size:12px;color:#5e6470;margin:5px 0 0}.selection-status{font-size:12px;color:#9f1239;min-height:18px;margin:8px 0}.clear-button,.locate,.jump{border:1px solid #cfd3da;background:white;border-radius:6px;color:#343942;cursor:pointer}.clear-button{padding:6px 9px;font-size:12px}.clear-button:disabled{cursor:default;opacity:.45}.section-title{font-size:13px;margin:18px 0 8px;color:#30343b}.callout{border:1px solid #d8dce3;border-radius:8px;background:#f8f9fb;padding:10px;font-size:12px;color:#4f5661}.callout.warning{border-color:#f3c76b;background:#fff9e8}.impact-grid{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin:8px 0}.metric{border:1px solid #e2e5ea;border-radius:6px;padding:7px}.metric-label{font-size:10px;text-transform:uppercase;letter-spacing:.04em;color:#747b86}.metric-value{font-size:12px;margin-top:2px;word-break:break-word}.frontier-group{border-left:3px solid #6366f1;padding:7px 9px;margin:8px 0;background:#f7f7ff;font-size:12px}.jump{padding:2px 6px;margin:3px 3px 0 0;font:11px ui-monospace,SFMono-Regular,monospace}.domain{margin:0 0 18px}.domain h3{font-size:13px;margin:0 0 7px;color:#424751}.diff{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:8px;padding:10px;border:1px solid #e0e2e6;border-radius:8px;margin:7px 0;cursor:default;outline:none}.diff:hover,.diff:focus-within,.diff.active{border-color:#e11d48;background:#fff4f6}.diff:focus{box-shadow:0 0 0 2px rgba(225,29,72,.18)}.diff-title{font-size:13px;font-weight:650;word-break:break-word}.diff-source{font-size:12px;color:#5f6671;margin-top:4px;word-break:break-word}.badges{display:flex;flex-wrap:wrap;gap:4px;margin-top:6px}.badge{font-size:10px;border-radius:999px;padding:2px 6px;background:#eef0f4;color:#4b5260}.badge.frontier{background:#e8e7ff;color:#3730a3}.badge.limited{background:#fff0cf;color:#92400e}.locate{align-self:start;padding:5px 7px;font-size:11px}.evidence{grid-column:2/4;margin-top:4px;border-top:1px solid #e4e6eb;padding-top:7px}.evidence>summary{cursor:pointer;font-size:12px;font-weight:650;color:#444b56}.evidence-section{margin:10px 0}.evidence-section h4{font-size:11px;text-transform:uppercase;letter-spacing:.04em;color:#676e79;margin:0 0 5px}.kv{width:100%;border-collapse:collapse;font:11px ui-monospace,SFMono-Regular,monospace}.kv th,.kv td{text-align:left;vertical-align:top;border-top:1px solid #eceef1;padding:4px;word-break:break-word}.kv th{width:44%;font-weight:500;color:#626975}.event-card,.fact-card,.diagnostic-card,.region-card{border:1px solid #e3e5e9;border-radius:6px;padding:7px;margin:5px 0;font-size:11px}.card-title{font-weight:650;word-break:break-word}.card-detail{color:#626975;margin-top:3px;word-break:break-word}.empty{font-size:11px;color:#777e88}.diagnostics-panel,.json-panel{border-top:1px solid #d7d9de;padding-top:12px;margin-top:20px}.diagnostics-panel>summary,.json-panel>summary{cursor:pointer;font-weight:650;font-size:13px}textarea{width:100%;height:360px;margin-top:9px;resize:vertical;border:1px solid #d7d9de;border-radius:6px;padding:10px;font:11px ui-monospace,SFMono-Regular,monospace;background:#f7f8fa}@media(max-width:900px){.layout{grid-template-columns:1fr;height:auto}.visuals{min-height:45vh}.sidebar{border-left:0;border-top:1px solid #d7d9de}.impact-grid{grid-template-columns:1fr}}@media(max-width:620px){.visuals{grid-template-columns:1fr;padding:12px}.sidebar{padding:14px}}
    $|</style></head><body>
    $|<main class="layout"><section class="visuals" aria-label="SVG previews">
    $|<article class="preview"><h2>Before</h2><div class="canvas"><iframe title="Before SVG" sandbox="" srcdoc="\{before_document}"></iframe><div class="overlay" data-overlay aria-hidden="true"></div></div></article>
    $|<article class="preview"><h2>After</h2><div class="canvas"><iframe title="After SVG" sandbox="" srcdoc="\{after_document}"></iframe><div class="overlay" data-overlay aria-hidden="true"></div></div></article>
    $|</section><aside class="sidebar"><header class="report-header"><div><h1>SVG Diff Report</h1><div class="summary" id="summary"></div></div><button class="clear-button" id="clear-selection" type="button" disabled>Clear highlight</button></header><div class="selection-status" id="selection-status" aria-live="polite"></div>
    $|<section aria-labelledby="impact-heading"><h2 class="section-title" id="impact-heading">Impact assessment</h2><div id="impact"></div></section>
    $|<section aria-labelledby="diff-heading"><h2 class="section-title" id="diff-heading">All Atomic Differences</h2><div id="diffs"></div></section>
    $|<details class="diagnostics-panel"><summary id="diagnostics-summary">Diagnostics</summary><div id="diagnostics"></div></details>
    $|<details class="json-panel"><summary>Complete JSON report</summary><textarea id="report-data" readonly aria-label="Complete Structured Report JSON">\{report_json}</textarea></details></aside></main>
    $|<script>
    $|const report=JSON.parse(document.getElementById('report-data').value);
    $|const root=document.getElementById('diffs');const impactRoot=document.getElementById('impact');const diagnosticsRoot=document.getElementById('diagnostics');const overlays=[...document.querySelectorAll('[data-overlay]')];const selectionStatus=document.getElementById('selection-status');const clearButton=document.getElementById('clear-selection');
    $|const changedFacts=new Map(report.changed_facts.map(value=>[value.id,value]));const diagnostics=new Map(report.diagnostics.map(value=>[value.id,value]));const eventsByDiff=new Map();for(const event of report.events){for(const id of event.atomic_difference_ids){const values=eventsByDiff.get(id)||[];values.push(event);eventsByDiff.set(id,values)}}
    $|const frontierDiffIds=new Set(report.impact_assessment.frontier_groups.flatMap(group=>group.atomic_difference_ids));const itemByDiff=new Map();let activeId=null;
    $|function node(tag,className,text){const value=document.createElement(tag);if(className)value.className=className;if(text!==undefined)value.textContent=text;return value}
    $|function scalar(value){if(value===null||value===undefined)return'unavailable';if(typeof value==='string')return value;if(typeof value==='number'||typeof value==='boolean')return String(value);return JSON.stringify(value)}
    $|function flatten(value,prefix,rows){if(value===null||value===undefined)return;if(Array.isArray(value)){rows.push([prefix,JSON.stringify(value)]);return}if(typeof value==='object'){for(const [key,child] of Object.entries(value))flatten(child,prefix?`${prefix}.${key}`:key,rows);return}rows.push([prefix,scalar(value)])}
    $|function tableFor(value,emptyText='No available values.'){const rows=[];flatten(value,'',rows);if(rows.length===0)return node('div','empty',emptyText);const table=node('table','kv');const body=document.createElement('tbody');for(const [key,text] of rows){const row=document.createElement('tr');const heading=document.createElement('th');heading.scope='row';heading.textContent=key;const cell=document.createElement('td');cell.textContent=text;row.append(heading,cell);body.append(row)}table.append(body);return table}
    $|function section(title){const wrapper=node('section','evidence-section');wrapper.append(node('h4','',title));return wrapper}
    $|function badge(text,className=''){return node('span',`badge ${className}`.trim(),text)}
    $|function factCard(id){const fact=changedFacts.get(id);const card=node('div','fact-card');card.dataset.factId=id;if(!fact){card.append(node('div','card-title',id),node('div','card-detail','Referenced Changed Fact is unavailable in this report.'));return card}card.append(node('div','card-title',`${fact.id} · ${fact.property}`));const before=fact.before?fact.before.authored_value:'unavailable';const after=fact.after?fact.after.authored_value:'unavailable';card.append(node('div','card-detail',`${JSON.stringify(before)} → ${JSON.stringify(after)} · subject ${fact.subject_id}`));card.append(node('div','card-detail',`Affected subjects: ${(fact.affected_subject_ids||[]).join(', ')||'none'}`));return card}
    $|function diagnosticCard(id){const diagnostic=diagnostics.get(id);const card=node('div','diagnostic-card');card.dataset.diagnosticId=id;if(!diagnostic){card.append(node('div','card-title',id),node('div','card-detail','Referenced Diagnostic is unavailable in this report.'));return card}card.append(node('div','card-title',`${diagnostic.id} · ${diagnostic.code}`));card.append(node('div','card-detail',`Subject ${diagnostic.subject_id}; layers ${(diagnostic.affected_evidence_layers||[]).join(', ')||'none'}`));const locations=(diagnostic.source_locations||[]).map(value=>`${value.source_role}[${value.source_span.start_offset},${value.source_span.end_offset})`).join(', ');card.append(node('div','card-detail',`Source locations: ${locations||'none'}`));return card}
    $|function regionCard(region){const card=node('div','region-card');card.dataset.regionId=region.id;card.append(node('div','card-title',`${region.id} · ${region.source}`));card.append(node('div','card-detail',`CSS bounds (${region.css_x}, ${region.css_y}, ${region.css_width}, ${region.css_height}); changed pixels ${region.changed_pixels}; viewport fraction ${region.viewport_fraction}`));const envelope=region.cause_envelope;card.append(node('div','card-detail',`Cause Envelope: ${envelope.guarantee}; coverage ${envelope.coverage}; fallback ${envelope.fallback_scope}`));const candidates=node('div','card-detail','Possible Changed Fact causes:');card.append(candidates);if((envelope.candidate_changed_fact_ids||[]).length===0){card.append(node('div','empty','No candidate Changed Facts.'))}else{for(const id of envelope.candidate_changed_fact_ids)card.append(factCard(id))}if((envelope.diagnostic_ids||[]).length>0){card.append(node('div','card-detail','Cause Diagnostics:'));for(const id of envelope.diagnostic_ids)card.append(diagnosticCard(id))}return card}
    $|function eventCard(event){const card=node('div','event-card');card.dataset.eventId=event.id;card.append(node('div','card-title',`${event.id} · subject ${event.primary_subject_id}`));card.append(node('div','card-detail',`Rendered status: ${event.rendered_outcome.status}; regions ${(event.difference_regions||[]).length}`));const magnitude=section('Rendered magnitude');magnitude.append(tableFor(event.rendered_outcome.magnitude,'Rendered magnitude unavailable.'));card.append(magnitude);const perceptual=section('Perceptual evidence status');perceptual.append(tableFor({color_status:event.rendered_outcome.perceptual_color.status,color_reason:event.rendered_outcome.perceptual_color.reason_code,color_magnitude:event.rendered_outcome.perceptual_color.magnitude,flip_status:event.rendered_outcome.perceptual_flip.status,flip_reason:event.rendered_outcome.perceptual_flip.reason_code,flip_statistics:event.rendered_outcome.perceptual_flip.statistics},'No perceptual evidence.'));card.append(perceptual);if((event.difference_regions||[]).length===0){card.append(node('div','empty','No Difference Regions for this event.'))}else{for(const region of event.difference_regions)card.append(regionCard(region))}return card}
    $|function impactCopy(assessment){if(assessment.status==='not_applicable')return'No candidate Visual Events are present.';if(assessment.frontier_relation==='tied')return'Frontier events are exactly tied under the declared measurements.';if(assessment.frontier_relation==='incomparable'||assessment.frontier_relation==='mixed')return'Distinct frontier groups are incomparable under this policy; displayed order is not an impact ranking.';if(assessment.status==='partial')return'At least one candidate lacks required Impact measurements; unavailable is not zero.';return'The frontier is derived from the declared raw measurements and is not a calibrated severity label.'}
    $|function renderImpact(){const assessment=report.impact_assessment;const reportMessage=report.analysis_status==='complete'?'Analysis is complete for the recorded coverage matrix.':report.analysis_status==='partial'?'Analysis is partial; inspect coverage and Diagnostics before interpreting missing evidence.':'Analysis failed; empty evidence inventories do not establish equality.';impactRoot.append(node('div',`callout ${report.analysis_status==='complete'?'':'warning'}`.trim(),reportMessage));const callout=node('div',`callout ${assessment.status==='partial'?'warning':''}`.trim(),impactCopy(assessment));impactRoot.append(callout);const grid=node('div','impact-grid');for(const [label,value] of [['Policy',assessment.policy_id],['Status',assessment.status],['Calibration',assessment.calibration_status],['Frontier relation',assessment.frontier_relation],['Candidate events',assessment.candidate_event_count],['Frontier groups',assessment.frontier_groups.length]]){const metric=node('div','metric');metric.append(node('div','metric-label',label),node('div','metric-value',String(value)));grid.append(metric)}impactRoot.append(grid);if(assessment.frontier_groups.length===0){impactRoot.append(node('div','empty','No frontier groups.'))}for(const [index,group] of assessment.frontier_groups.entries()){const card=node('div','frontier-group');card.append(node('div','card-title',`Frontier group ${index+1}`));card.append(node('div','card-detail',group.measurements?`changed_pixel_fraction=${group.measurements.changed_pixel_fraction}; linear_premultiplied_rgba_rmse=${group.measurements.linear_premultiplied_rgba_rmse}`:'Measurements unavailable; not zero.'));const events=node('div','card-detail',`Events: ${group.event_ids.join(', ')||'none'}`);card.append(events);const links=node('div','card-detail','Atomic Differences:');card.append(links);if(group.atomic_difference_ids.length===0){card.append(node('span','empty',' none'))}else{for(const id of group.atomic_difference_ids){const button=node('button','jump',id);button.type='button';button.dataset.jumpDiff=id;button.setAttribute('aria-label',`Jump to ${id}`);card.append(button)}}impactRoot.append(card)}if(assessment.domination_witnesses.length>0){const witnesses=section('Domination witnesses');for(const value of assessment.domination_witnesses)witnesses.append(node('div','card-detail',`${value.dominated_event_id} excluded by ${value.dominant_event_id} · ${value.rule_id}`));impactRoot.append(witnesses)}}
    $|function clearRegions(){for(const overlay of overlays)overlay.replaceChildren()}
    $|function showRegions(id){clearRegions();const events=eventsByDiff.get(id)||[];let count=0;for(const event of events){for(const region of event.difference_regions||[]){for(const overlay of overlays){const box=node('div','region');box.dataset.regionId=region.id;box.style.left=`${region.css_x/report.profile.viewport_width*100}%`;box.style.top=`${region.css_y/report.profile.viewport_height*100}%`;box.style.width=`${region.css_width/report.profile.viewport_width*100}%`;box.style.height=`${region.css_height/report.profile.viewport_height*100}%`;box.title=`${region.id} · ${region.source}`;overlay.append(box)}count++}}selectionStatus.textContent=count===0?`${id}: no Difference Regions`:`${id}: ${count} linked region${count===1?'':'s'} highlighted on both previews`}
    $|function restoreActive(){if(activeId)showRegions(activeId);else{clearRegions();selectionStatus.textContent=''}}
    $|function setActive(id){const next=activeId===id?null:id;for(const item of itemByDiff.values()){const active=item.dataset.diffId===next;item.classList.toggle('active',active);const locate=item.querySelector('[data-locate]');locate.setAttribute('aria-pressed',String(active))}activeId=next;clearButton.disabled=activeId===null;restoreActive()}
    $|function renderDifference(diff){const item=node('article','diff');item.tabIndex=0;item.dataset.diffId=diff.id;item.setAttribute('aria-label',`${diff.domain} ${diff.id}`);const check=document.createElement('input');check.type='checkbox';check.setAttribute('aria-label',`Mark ${diff.id} reviewed`);const body=node('div','diff-body');body.append(node('div','diff-title',`${diff.domain} · ${diff.id}`));body.append(node('div','diff-source',`${JSON.stringify(diff.source_before)} → ${JSON.stringify(diff.source_after)}`));const badges=node('div','badges');badges.append(badge(diff.computed_relation.status,diff.computed_relation.status==='indeterminate'?'limited':''));for(const layer of diff.evidence_layers)badges.append(badge(layer));if(frontierDiffIds.has(diff.id))badges.append(badge('Impact frontier','frontier'));body.append(badges);const locate=node('button','locate','Locate');locate.type='button';locate.dataset.locate=diff.id;locate.setAttribute('aria-label',`Persistently highlight regions for ${diff.id}`);locate.setAttribute('aria-pressed','false');const evidence=node('details','evidence');evidence.dataset.evidence=diff.id;evidence.append(node('summary','',`Inspect evidence for ${diff.id}`));const magnitude=section('How much · non-null magnitude evidence');const magnitudeValue={parameter_delta_css_px:diff.parameter_delta_css_px,presence_magnitude:diff.presence_magnitude,magnitude:diff.magnitude};magnitude.append(tableFor(magnitudeValue,'No non-null magnitude fields.'));evidence.append(magnitude);const relation=section('What changed · computed and source evidence');relation.append(tableFor({subject_role:diff.subject_role,subject_alignment_id:diff.subject_alignment_id,computed_status:diff.computed_relation.status,computed_reason:diff.computed_relation.reason_code,missing_side:diff.computed_relation.missing_side,evidence_layers:diff.evidence_layers,domain_ordering:diff.domain_ordering}));evidence.append(relation);const facts=section('Changed Facts linked by this Atomic Difference');if(diff.changed_fact_ids.length===0)facts.append(node('div','empty','No Changed Fact links.'));else for(const id of diff.changed_fact_ids)facts.append(factCard(id));evidence.append(facts);const events=section('Where and why · Visual Events, regions, and Cause Envelopes');const linked=eventsByDiff.get(diff.id)||[];if(linked.length===0)events.append(node('div','empty','No linked Visual Events.'));else for(const event of linked)events.append(eventCard(event));evidence.append(events);const diagnosticIds=new Set(diff.computed_relation.diagnostic_ids||[]);for(const event of linked)for(const region of event.difference_regions||[])for(const id of region.cause_envelope.diagnostic_ids||[])diagnosticIds.add(id);const linkedDiagnostics=section('Linked Diagnostics');if(diagnosticIds.size===0)linkedDiagnostics.append(node('div','empty','No linked Diagnostics.'));else for(const id of diagnosticIds)linkedDiagnostics.append(diagnosticCard(id));evidence.append(linkedDiagnostics);item.append(check,body,locate,evidence);item.addEventListener('mouseenter',()=>showRegions(diff.id));item.addEventListener('mouseleave',restoreActive);item.addEventListener('focusin',()=>showRegions(diff.id));item.addEventListener('focusout',event=>{if(!item.contains(event.relatedTarget))restoreActive()});item.addEventListener('click',event=>{if(event.target.closest('input,button,summary,details'))return;setActive(diff.id)});item.addEventListener('keydown',event=>{if(event.target===item&&(event.key==='Enter'||event.key===' ')){event.preventDefault();setActive(diff.id)}});check.addEventListener('click',event=>event.stopPropagation());locate.addEventListener('click',event=>{event.stopPropagation();setActive(diff.id)});itemByDiff.set(diff.id,item);return item}
    $|function renderDifferences(){if(report.atomic_differences.length===0){root.append(node('div','callout',report.analysis_status==='complete'?'No Atomic Differences are present in this profile-scoped report.':'No Atomic Differences are present; coverage and Diagnostics constrain interpretation.'));return}const groups=new Map();for(const diff of report.atomic_differences){if(!groups.has(diff.domain))groups.set(diff.domain,[]);groups.get(diff.domain).push(diff)}for(const [domain,diffs] of groups){const wrapper=node('section','domain');wrapper.append(node('h3','',`${domain} (${diffs.length})`));for(const diff of diffs)wrapper.append(renderDifference(diff));root.append(wrapper)}}
    $|function renderDiagnostics(){document.getElementById('diagnostics-summary').textContent=`Diagnostics (${report.diagnostics.length})`;if(report.diagnostics.length===0){diagnosticsRoot.append(node('div','empty','No Diagnostic records.'));return}for(const diagnostic of report.diagnostics)diagnosticsRoot.append(diagnosticCard(diagnostic.id))}
    $|document.getElementById('summary').textContent=`${report.analysis_status} · ${report.atomic_differences.length} differences · ${report.events.length} events · ${report.diagnostics.length} diagnostics`;
    $|renderImpact();renderDifferences();renderDiagnostics();clearButton.addEventListener('click',()=>{if(activeId)setActive(activeId)});document.addEventListener('click',event=>{const jump=event.target.closest('[data-jump-diff]');if(!jump)return;const item=itemByDiff.get(jump.dataset.jumpDiff);if(item){item.scrollIntoView({block:'center'});item.focus()}});
    $|</script></body></html>
  html
}
