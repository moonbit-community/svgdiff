{
  "schema_version": "svgdiff-terminal-magnitude-gate/1",
  "canonical_rule": "preserve_named_raw_magnitude_dimensions_and_availability",
  "dimensions": [
    {
      "id": "exact_parameter_scales",
      "fields": [
        "parameter_abs_user_units",
        "parameter_signed_user_units",
        "symmetric_relative",
        "parameter_abs_css_px",
        "parameter_viewport_fraction",
        "parameter_entity_fraction"
      ],
      "units_or_denominators": ["local_user_units", "css_px", "viewport_diagonal", "entity_bounds_diagonal"],
      "availability_rule": "retain_each_valid_scale_independently_without_raster_quantization",
      "authorities": ["docs/core-model.md", "docs/agent-report-guide.md"],
      "tests": ["modules/svgdiff/engine/magnitude_test.mbt", "modules/svgdiff/engine/internal/diff/path_geometry_wbtest.mbt"]
    },
    {
      "id": "transform_effect",
      "fields": ["magnitude.transform_effect"],
      "units_or_denominators": ["css_px", "degrees", "signed_scale", "exact_matrix_coefficients"],
      "availability_rule": "preserve_tagged_effect_kind_and_never_reduce_singular_residuals_to_one_scalar",
      "authorities": ["docs/core-model.md", "docs/agent-report-guide.md"],
      "tests": ["modules/svgdiff/engine/internal/diff/transform_diff_wbtest.mbt"]
    },
    {
      "id": "painted_boundary_geometry",
      "fields": ["painted_boundary_displacement.mean_css_px", "painted_boundary_displacement.p95_css_px", "painted_boundary_displacement.max_css_px"],
      "units_or_denominators": ["css_px", "before_boundary_samples", "after_boundary_samples"],
      "availability_rule": "retain_symmetric_distribution_and_both_sample_counts_only_for_two_sided_admitted_geometry",
      "authorities": ["docs/core-model.md", "docs/agent-report-guide.md"],
      "tests": ["modules/svgdiff/engine/internal/diff/difference_regions_wbtest.mbt", "modules/svgdiff/engine/internal/measurement/difference_magnitudes_wbtest.mbt"]
    },
    {
      "id": "painted_alpha_coverage",
      "fields": ["painted_coverage_difference.before_coverage_css_px2", "painted_coverage_difference.after_coverage_css_px2", "painted_coverage_difference.absolute_difference_css_px2", "painted_coverage_difference.union_coverage_css_px2", "painted_coverage_difference.fraction"],
      "units_or_denominators": ["css_px2", "alpha_coverage_union"],
      "availability_rule": "measure_alpha_coverage_separately_from_rgb_and_preserve_both_sides",
      "authorities": ["docs/core-model.md", "docs/agent-report-guide.md"],
      "tests": ["modules/svgdiff/engine/internal/diff/difference_regions_wbtest.mbt", "modules/svgdiff/engine/magnitude_test.mbt"]
    },
    {
      "id": "presence_footprint",
      "fields": ["presence_magnitude.affected_entity_count", "presence_magnitude.bounds_area_css_px2", "presence_magnitude.bounds_viewport_fraction", "presence_magnitude.painted_area_css_px2", "presence_magnitude.painted_viewport_fraction"],
      "units_or_denominators": ["entities", "css_px2", "comparison_viewport_area"],
      "availability_rule": "retain_one_sided_bounds_and_painted_footprint_without_fabricating_two_sided_geometry",
      "authorities": ["docs/core-model.md", "docs/agent-report-guide.md"],
      "tests": ["modules/svgdiff/engine/magnitude_test.mbt", "modules/svgdiff/engine/structured_report_test.mbt"]
    },
    {
      "id": "scene_raster",
      "fields": ["changed_pixels", "changed_pixel_fraction", "rgba8_rmse", "linear_premultiplied_rgba_rmse"],
      "units_or_denominators": ["comparison_viewport_pixels", "rgba8_normalized_error", "linear_premultiplied_rgba_error"],
      "availability_rule": "retain_changed_area_and_both_raster_error_spaces_without_overriding_exact_parameters",
      "authorities": ["docs/core-model.md", "docs/impact-assessment.md"],
      "tests": ["modules/svgdiff/engine/magnitude_test.mbt", "modules/svgdiff/engine/internal/diff/difference_regions_wbtest.mbt"]
    },
    {
      "id": "intrinsic_raster",
      "fields": ["intrinsic_raster.before_width", "intrinsic_raster.before_height", "intrinsic_raster.after_width", "intrinsic_raster.after_height", "intrinsic_raster.compared_pixels", "intrinsic_raster.changed_pixels", "intrinsic_raster.changed_pixel_fraction", "intrinsic_raster.rgba8_rmse", "intrinsic_raster.linear_premultiplied_rgba_rmse"],
      "units_or_denominators": ["decoded_resource_pixels", "rgba8_normalized_error", "linear_premultiplied_rgba_error"],
      "availability_rule": "keep_decoded_resource_magnitude_distinct_from_final_canvas_rendering",
      "authorities": ["docs/core-model.md", "docs/agent-report-guide.md"],
      "tests": ["modules/svgdiff/engine/internal/diff/embedded_image_diff_wbtest.mbt"]
    },
    {
      "id": "perceptual_color",
      "fields": ["perceptual_color.magnitude.method_id", "perceptual_color.magnitude.sample_count", "perceptual_color.magnitude.mean_delta_e_ok"],
      "units_or_denominators": ["delta_e_ok", "event_changed_pixels_after_explicit_background"],
      "availability_rule": "compute_only_with_explicit_opaque_srgb_background_and_available_event_pixels",
      "authorities": ["docs/core-model.md", "docs/agent-report-guide.md"],
      "tests": ["modules/svgdiff/engine/internal/diff/perceptual_color_wbtest.mbt"]
    },
    {
      "id": "perceptual_flip",
      "fields": ["perceptual_flip.map", "perceptual_flip.statistics.canvas_mean", "perceptual_flip.statistics.event_region_mean", "perceptual_flip.statistics.response_p95", "perceptual_flip.statistics.response_maximum", "perceptual_flip.statistics.area_above_threshold"],
      "units_or_denominators": ["flip_response", "whole_canvas", "event_region", "response_population", "explicit_threshold"],
      "availability_rule": "compute_only_with_explicit_background_and_viewing_conditions_while_preserving_map_and_pooling_denominators",
      "authorities": ["docs/core-model.md", "docs/agent-report-guide.md"],
      "tests": ["modules/svgdiff/engine/internal/diff/perceptual_flip_wbtest.mbt"]
    }
  ],
  "anti_collapse_rules": [
    "no_visibility_boolean",
    "no_universal_cross_domain_scalar",
    "no_missing_as_measured_zero",
    "no_domain_ordering_as_raw_evidence",
    "no_impact_as_magnitude_authority",
    "no_raster_quantization_over_exact_parameter",
    "no_alpha_coverage_as_rgb_difference",
    "no_perceptual_metric_as_equality_or_severity"
  ]
}
