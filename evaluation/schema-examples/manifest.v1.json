      "output": "schema/examples/tiny-numeric-geometry.json",
      "expected": {
        "analysis_status": "partial",
        "domains": ["geometry.position"],
        "computed_relations": ["different"],
        "diagnostic_codes": ["renderer_fractional_geometry_unproven"],
        "magnitude_checks": [
          { "domain": "geometry.position", "field": "magnitude.parameter_abs_user_units", "op": "gt", "value": 0 },
          { "domain": "geometry.position", "field": "magnitude.parameter_abs_user_units", "op": "lt", "value": 0.0001 }
        ]
      }
