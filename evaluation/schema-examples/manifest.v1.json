      "output": "schema/examples/equivalent-color-spelling.json",
      "expected": {
        "analysis_status": "complete",
        "domains": ["paint.fill"],
        "computed_relations": ["equivalent"],
        "diagnostic_codes": [],
        "magnitude_checks": [
          { "domain": "paint.fill", "field": "magnitude.raster_changed_pixel_fraction", "op": "eq", "value": 0 }
        ]
      }
    },
    {
      "id": "tiny-numeric-geometry",
