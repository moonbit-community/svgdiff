{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/svgdiff/source-audit/1.0",
  "title": "SVG Diff Nonvisual Source Audit 1.0",
  "type": "object",
  "required": [
    "audit_schema_version",
    "analysis_status",
    "differences",
    "diagnostics"
  ],
  "properties": {
    "audit_schema_version": { "const": "1.0" },
    "analysis_status": { "enum": ["complete", "failed"] },
    "differences": {
      "type": "array",
      "items": { "$ref": "#/$defs/difference" }
    },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagnostic" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sourceSpan": {
      "type": "object",
      "required": ["start_offset", "end_offset"],
      "properties": {
        "start_offset": { "type": "integer", "minimum": 0 },
        "end_offset": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "fact": {
      "type": "object",
      "required": ["kind", "path", "name", "authored_value", "source_span"],
      "properties": {
        "kind": { "enum": ["element_content", "attribute"] },
        "path": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "authored_value": { "type": "string" },
        "source_span": { "$ref": "#/$defs/sourceSpan" }
      },
      "additionalProperties": false
    },
    "optionalFact": {
      "anyOf": [
        { "$ref": "#/$defs/fact" },
        { "type": "null" }
      ]
    },
    "difference": {
      "type": "object",
      "required": ["id", "kind", "path", "name", "before", "after"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["element_content", "attribute"] },
        "path": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "before": { "$ref": "#/$defs/optionalFact" },
        "after": { "$ref": "#/$defs/optionalFact" }
      },
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "required": ["code", "source_role", "source_span"],
      "properties": {
        "code": { "const": "svg_parse_failed" },
        "source_role": { "enum": ["before", "after"] },
        "source_span": {
          "anyOf": [
            { "$ref": "#/$defs/sourceSpan" },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
