{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://milky2018.github.io/svgdiff/schema/4.0",
  "title": "SVG Diff Structured Report 4.0",
  "type": "object",
  "required": [
    "schema_version",
    "analysis_status",
    "comparison",
    "canvas",
    "scene",
    "difference_groups",
    "events",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "4.0" },
    "analysis_status": { "enum": ["complete", "partial", "failed"] },
    "comparison": { "$ref": "#/$defs/comparison" },
    "canvas": { "$ref": "#/$defs/canvas" },
    "scene": { "$ref": "#/$defs/scene" },
    "difference_groups": {
      "type": "array",
      "items": { "$ref": "#/$defs/differenceGroup" }
    },
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/event" }
    },
    "limitations": {
      "type": "array",
      "items": { "$ref": "#/$defs/limitation" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "scene": {
      "type": "object",
      "required": ["summary", "before_objects", "after_objects", "before_relations", "after_relations", "alignments", "events", "evidence_coverage"],
      "properties": {
        "summary": { "$ref": "#/$defs/sceneSummary" },
        "before_objects": { "type": "array", "items": { "$ref": "#/$defs/visualObject" } },
        "after_objects": { "type": "array", "items": { "$ref": "#/$defs/visualObject" } },
        "before_relations": { "type": "array", "items": { "$ref": "#/$defs/visualRelation" } },
        "after_relations": { "type": "array", "items": { "$ref": "#/$defs/visualRelation" } },
        "alignments": { "type": "array", "items": { "$ref": "#/$defs/visualObjectAlignment" } },
        "events": { "type": "array", "items": { "$ref": "#/$defs/visualChangeEvent" } },
        "evidence_coverage": { "$ref": "#/$defs/visualEvidenceCoverage" }
      },
      "additionalProperties": false
    },
    "sceneSummary": {
      "type": "object",
      "required": ["status", "content", "object_set", "relation_graph", "layout", "style", "representation", "before_object_count", "after_object_count", "before_relation_count", "after_relation_count"],
      "properties": {
        "status": { "enum": ["computed", "not_computed"] },
        "content": { "enum": ["preserved", "changed", "indeterminate"] },
        "object_set": { "enum": ["preserved", "changed", "indeterminate"] },
        "relation_graph": { "enum": ["preserved", "changed", "indeterminate"] },
        "layout": { "enum": ["preserved", "changed", "indeterminate"] },
        "style": { "enum": ["preserved", "changed", "indeterminate"] },
        "representation": { "enum": ["preserved", "changed", "indeterminate"] },
        "before_object_count": { "type": "integer", "minimum": 0 },
        "after_object_count": { "type": "integer", "minimum": 0 },
        "before_relation_count": { "type": "integer", "minimum": 0 },
        "after_relation_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "visualObject": {
      "type": "object",
      "required": ["id", "role", "primitives", "subjects"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "role": { "enum": ["entity", "graphic"] },
        "label": { "type": "string" },
        "text": { "type": "array", "items": { "type": "string" } },
        "symbols": { "type": "array", "items": { "type": "string" } },
        "primitives": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "subjects": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "bounds": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 4,
          "maxItems": 4
        }
      },
      "additionalProperties": false
    },
    "visualRelation": {
      "type": "object",
      "required": ["id", "endpoints", "endpoint_basis"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "endpoints": { "type": "array", "items": { "type": "string", "minLength": 1 }, "maxItems": 2 },
        "endpoint_basis": { "enum": ["nearest_endpoint", "unresolved"] }
      },
      "additionalProperties": false
    },
    "visualObjectAlignment": {
      "type": "object",
      "required": ["id", "relation", "before", "after", "basis", "ambiguity"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "relation": { "enum": ["correspondence", "equivalence_class", "insertion", "deletion", "unresolved"] },
        "before": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "after": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "basis": { "type": "string", "minLength": 1 },
        "ambiguity": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "visualChangeEvent": {
      "type": "object",
      "required": ["id", "kind", "scope", "object_alignment_ids", "difference_ids", "evidence_event_ids", "evidence_difference_count", "evidence_domains"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["content.change", "object.presence", "relation.change", "layout.reflow", "layout.global_affine", "style.change", "representation.change"] },
        "scope": { "enum": ["object", "systemic", "comparison"] },
        "object_alignment_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "difference_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "evidence_event_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "evidence_difference_count": { "type": "integer", "minimum": 0 },
        "evidence_domains": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["domain", "count"],
            "properties": {
              "domain": { "type": "string", "minLength": 1 },
              "count": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "visualEvidenceCoverage": {
      "type": "object",
      "required": ["effective_difference_count", "classified_difference_count", "residual_difference_count", "residual_domains"],
      "properties": {
        "effective_difference_count": { "type": "integer", "minimum": 0 },
        "classified_difference_count": { "type": "integer", "minimum": 0 },
        "residual_difference_count": { "type": "integer", "minimum": 0 },
        "residual_domains": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["domain", "count"],
            "properties": {
              "domain": { "type": "string", "minLength": 1 },
              "count": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "comparison": {
      "type": "object",
      "required": ["viewport"],
      "properties": {
        "viewport": {
          "type": "object",
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "perceptual_background": {
          "type": "object",
          "required": ["red", "green", "blue"],
          "properties": {
            "red": { "type": "integer", "minimum": 0, "maximum": 255 },
            "green": { "type": "integer", "minimum": 0, "maximum": 255 },
            "blue": { "type": "integer", "minimum": 0, "maximum": 255 }
          },
          "additionalProperties": false
        },
        "flip_pixels_per_degree": { "type": "number", "minimum": 1, "maximum": 4096 },
        "flip_error_threshold": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "canvas": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["computed", "not_computed"] },
        "reason": { "type": "string", "minLength": 1 },
        "changed_pixels": { "type": "integer", "minimum": 0 },
        "changed_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
        "linear_rgba_rmse": { "type": "number", "minimum": 0, "maximum": 1 },
        "perceptual_difference": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "differenceGroup": {
      "type": "object",
      "required": ["category", "items"],
      "properties": {
        "category": {
          "enum": ["presence", "geometry", "paint", "compositing", "resource", "text", "structure", "other"]
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/difference" }
        }
      },
      "additionalProperties": false
    },
    "difference": {
      "type": "object",
      "required": ["id", "subject", "subject_role", "kind", "source", "effective"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "subject": { "type": "string", "minLength": 1 },
        "subject_role": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "source": {
          "type": "object",
          "required": ["before", "after"],
          "properties": {
            "before": { "type": "string" },
            "after": { "type": "string" }
          },
          "additionalProperties": false
        },
        "effective": {
          "type": "object",
          "required": ["relation"],
          "properties": {
            "relation": { "enum": ["equivalent", "different", "indeterminate", "not_applicable"] },
            "reason": { "type": "string", "minLength": 1 },
            "limitation_ids": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "additionalProperties": false
        },
        "magnitude": { "$ref": "#/$defs/magnitude" }
      },
      "additionalProperties": false
    },
    "magnitude": {
      "type": "object",
      "properties": {
        "parameter_abs_user_units": { "type": "number", "minimum": 0 },
        "parameter_signed_user_units": { "type": "number" },
        "symmetric_relative": { "type": "number", "minimum": 0 },
        "parameter_abs_css_px": { "type": "number", "minimum": 0 },
        "parameter_viewport_fraction": { "type": "number", "minimum": 0 },
        "parameter_entity_fraction": { "type": "number", "minimum": 0 },
        "geometry_displacement_css_px": { "type": "number", "minimum": 0 },
        "geometry_viewport_fraction": { "type": "number", "minimum": 0 },
        "presence_painted_viewport_fraction": { "type": "number", "minimum": 0 },
        "painted_boundary_displacement": { "$ref": "#/$defs/boundary" },
        "painted_coverage_difference": { "$ref": "#/$defs/coverage" },
        "intrinsic_raster": { "$ref": "#/$defs/intrinsicRaster" },
        "transform": { "type": "object" },
        "presence": { "type": "object" }
      },
      "additionalProperties": false
    },
    "boundary": {
      "type": "object",
      "required": ["mean_css_px", "p95_css_px", "max_css_px"],
      "properties": {
        "mean_css_px": { "type": "number", "minimum": 0 },
        "p95_css_px": { "type": "number", "minimum": 0 },
        "max_css_px": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": ["before_css_px2", "after_css_px2", "absolute_difference_css_px2", "union_css_px2", "fraction"],
      "properties": {
        "before_css_px2": { "type": "number", "minimum": 0 },
        "after_css_px2": { "type": "number", "minimum": 0 },
        "absolute_difference_css_px2": { "type": "number", "minimum": 0 },
        "union_css_px2": { "type": "number", "minimum": 0 },
        "fraction": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "intrinsicRaster": {
      "type": "object",
      "required": ["before_size", "after_size"],
      "properties": {
        "before_size": { "$ref": "#/$defs/size" },
        "after_size": { "$ref": "#/$defs/size" },
        "compared_pixels": { "type": "integer", "minimum": 0 },
        "changed_pixels": { "type": "integer", "minimum": 0 },
        "changed_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
        "linear_rgba_rmse": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "size": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0 },
      "minItems": 2,
      "maxItems": 2
    },
    "event": {
      "type": "object",
      "required": ["id", "subject", "difference_ids", "outcome", "regions"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "subject": { "type": "string", "minLength": 1 },
        "difference_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "outcome": { "$ref": "#/$defs/outcome" },
        "regions": {
          "type": "array",
          "items": { "$ref": "#/$defs/region" }
        }
      },
      "additionalProperties": false
    },
    "outcome": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["computed", "not_computed"] },
        "reason": { "type": "string", "minLength": 1 },
        "changed_pixels": { "type": "integer", "minimum": 0 },
        "changed_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
        "linear_rgba_rmse": { "type": "number", "minimum": 0, "maximum": 1 },
        "perceptual_color": { "type": "object" },
        "perceptual_difference": { "type": "object" },
        "isolated_subject": { "$ref": "#/$defs/isolatedSubject" }
      },
      "additionalProperties": false
    },
    "isolatedSubject": {
      "type": "object",
      "properties": {
        "painted_boundary_displacement": { "$ref": "#/$defs/boundary" },
        "painted_coverage_difference": { "$ref": "#/$defs/coverage" }
      },
      "anyOf": [
        { "required": ["painted_boundary_displacement"] },
        { "required": ["painted_coverage_difference"] }
      ],
      "additionalProperties": false
    },
    "region": {
      "type": "object",
      "required": ["id", "kind", "bounds", "changed_pixels", "viewport_fraction", "possible_causes"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["observed", "conservative"] },
        "bounds": {
          "type": "object",
          "required": ["x", "y", "width", "height"],
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "width": { "type": "number", "minimum": 0 },
            "height": { "type": "number", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "changed_pixels": { "type": "integer", "minimum": 0 },
        "viewport_fraction": { "type": "number", "minimum": 0 },
        "possible_causes": {
          "anyOf": [
            {
              "type": "object",
              "required": ["guarantee", "coverage", "scope", "candidate_difference_ids"],
              "properties": {
                "guarantee": { "enum": ["sound_overapproximation", "not_established"] },
                "coverage": { "enum": ["complete", "partial", "failed"] },
                "scope": { "const": "event_region" },
                "candidate_difference_ids": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "minLength": 1 }
                },
                "limitation_ids": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["guarantee", "coverage", "scope"],
              "properties": {
                "guarantee": { "enum": ["sound_overapproximation", "not_established"] },
                "coverage": { "enum": ["complete", "partial", "failed"] },
                "scope": { "const": "comparison" },
                "limitation_ids": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "limitation": {
      "type": "object",
      "required": ["id", "code", "subject", "affects"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "code": { "type": "string", "minLength": 1 },
        "subject": { "type": "string", "minLength": 1 },
        "affects": {
          "type": "array",
          "items": { "enum": ["source_semantics", "computed_appearance", "rendered_evidence"] }
        }
      },
      "additionalProperties": false
    }
  }
}
