{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/svgdiff/schema/1.46",
  "title": "SVG Diff Structured Report 1.46",
  "type": "object",
  "required": [
    "schema_version",
    "analysis_status",
    "comparison",
    "canvas",
    "difference_groups",
    "events",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "1.46" },
    "analysis_status": { "enum": ["complete", "partial", "failed"] },
    "comparison": { "$ref": "#/$defs/comparison" },
    "canvas": { "$ref": "#/$defs/canvas" },
    "difference_groups": {
      "type": "array",
      "items": { "$ref": "#/$defs/differenceGroup" }
    },
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/event" }
    },
    "limitations": {
      "type": "array",
      "items": { "$ref": "#/$defs/limitation" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "comparison": {
      "type": "object",
      "required": ["viewport"],
      "properties": {
        "viewport": {
          "type": "object",
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "perceptual_background": {
          "type": "object",
          "required": ["red", "green", "blue"],
          "properties": {
            "red": { "type": "integer", "minimum": 0, "maximum": 255 },
            "green": { "type": "integer", "minimum": 0, "maximum": 255 },
            "blue": { "type": "integer", "minimum": 0, "maximum": 255 }
          },
          "additionalProperties": false
        },
        "flip_pixels_per_degree": { "type": "number", "minimum": 1, "maximum": 4096 },
        "flip_error_threshold": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "canvas": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["computed", "not_computed"] },
        "reason": { "type": "string", "minLength": 1 },
        "changed_pixels": { "type": "integer", "minimum": 0 },
        "changed_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
        "linear_rgba_rmse": { "type": "number", "minimum": 0, "maximum": 1 },
        "perceptual_difference": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "differenceGroup": {
      "type": "object",
      "required": ["category", "items"],
      "properties": {
        "category": {
          "enum": ["presence", "geometry", "paint", "compositing", "resource", "text", "structure", "other"]
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/difference" }
        }
      },
      "additionalProperties": false
    },
    "difference": {
      "type": "object",
      "required": ["id", "subject", "subject_role", "kind", "source", "effective"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "subject": { "type": "string", "minLength": 1 },
        "subject_role": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "source": {
          "type": "object",
          "required": ["before", "after"],
          "properties": {
            "before": { "type": "string" },
            "after": { "type": "string" }
          },
          "additionalProperties": false
        },
        "effective": {
          "type": "object",
          "required": ["relation"],
          "properties": {
            "relation": { "enum": ["equivalent", "different", "indeterminate", "not_applicable"] },
            "reason": { "type": "string", "minLength": 1 },
            "limitation_ids": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "additionalProperties": false
        },
        "magnitude": { "$ref": "#/$defs/magnitude" }
      },
      "additionalProperties": false
    },
    "magnitude": {
      "type": "object",
      "properties": {
        "parameter_abs_user_units": { "type": "number", "minimum": 0 },
        "parameter_signed_user_units": { "type": "number" },
        "symmetric_relative": { "type": "number", "minimum": 0 },
        "parameter_abs_css_px": { "type": "number", "minimum": 0 },
        "parameter_viewport_fraction": { "type": "number", "minimum": 0 },
        "parameter_entity_fraction": { "type": "number", "minimum": 0 },
        "geometry_displacement_css_px": { "type": "number", "minimum": 0 },
        "geometry_viewport_fraction": { "type": "number", "minimum": 0 },
        "presence_painted_viewport_fraction": { "type": "number", "minimum": 0 },
        "raster_changed_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
        "raster_linear_rgba_rmse": { "type": "number", "minimum": 0, "maximum": 1 },
        "painted_boundary_displacement": { "$ref": "#/$defs/boundary" },
        "painted_coverage_difference": { "$ref": "#/$defs/coverage" },
        "intrinsic_raster": { "$ref": "#/$defs/intrinsicRaster" },
        "transform": { "type": "object" },
        "presence": { "type": "object" }
      },
      "additionalProperties": false
    },
    "boundary": {
      "type": "object",
      "required": ["mean_css_px", "p95_css_px", "max_css_px"],
      "properties": {
        "mean_css_px": { "type": "number", "minimum": 0 },
        "p95_css_px": { "type": "number", "minimum": 0 },
        "max_css_px": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": ["before_css_px2", "after_css_px2", "absolute_difference_css_px2", "union_css_px2", "fraction"],
      "properties": {
        "before_css_px2": { "type": "number", "minimum": 0 },
        "after_css_px2": { "type": "number", "minimum": 0 },
        "absolute_difference_css_px2": { "type": "number", "minimum": 0 },
        "union_css_px2": { "type": "number", "minimum": 0 },
        "fraction": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "intrinsicRaster": {
      "type": "object",
      "required": ["before_size", "after_size"],
      "properties": {
        "before_size": { "$ref": "#/$defs/size" },
        "after_size": { "$ref": "#/$defs/size" },
        "compared_pixels": { "type": "integer", "minimum": 0 },
        "changed_pixels": { "type": "integer", "minimum": 0 },
        "changed_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
        "linear_rgba_rmse": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "size": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0 },
      "minItems": 2,
      "maxItems": 2
    },
    "event": {
      "type": "object",
      "required": ["id", "subject", "difference_ids", "outcome", "regions"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "subject": { "type": "string", "minLength": 1 },
        "difference_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "outcome": { "$ref": "#/$defs/outcome" },
        "regions": {
          "type": "array",
          "items": { "$ref": "#/$defs/region" }
        }
      },
      "additionalProperties": false
    },
    "outcome": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["computed", "not_computed"] },
        "reason": { "type": "string", "minLength": 1 },
        "changed_pixels": { "type": "integer", "minimum": 0 },
        "changed_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
        "linear_rgba_rmse": { "type": "number", "minimum": 0, "maximum": 1 },
        "perceptual_color": { "type": "object" },
        "perceptual_difference": { "type": "object" }
      },
      "additionalProperties": false
    },
    "region": {
      "type": "object",
      "required": ["id", "kind", "bounds", "changed_pixels", "viewport_fraction", "possible_causes"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["observed", "conservative"] },
        "bounds": {
          "type": "object",
          "required": ["x", "y", "width", "height"],
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "width": { "type": "number", "minimum": 0 },
            "height": { "type": "number", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "changed_pixels": { "type": "integer", "minimum": 0 },
        "viewport_fraction": { "type": "number", "minimum": 0 },
        "possible_causes": {
          "type": "object",
          "required": ["guarantee", "coverage", "candidate_difference_ids"],
          "properties": {
            "guarantee": { "enum": ["sound_overapproximation", "not_established"] },
            "coverage": { "enum": ["complete", "partial", "failed"] },
            "candidate_difference_ids": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "limitation_ids": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "limitation": {
      "type": "object",
      "required": ["id", "code", "subject", "affects"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "code": { "type": "string", "minLength": 1 },
        "subject": { "type": "string", "minLength": 1 },
        "affects": {
          "type": "array",
          "items": { "enum": ["source_semantics", "computed_appearance", "rendered_evidence"] }
        }
      },
      "additionalProperties": false
    }
  }
}
