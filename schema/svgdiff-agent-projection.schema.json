{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://milky2018.github.io/svgdiff/schema/agent-projection-record-1.json",
  "title": "SVG Diff Agent projection JSONL record",
  "anyOf": [
    { "$ref": "#/$defs/headerRecord" },
    { "$ref": "#/$defs/itemRecord" }
  ],
  "$defs": {
    "headerRecord": {
      "type": "object",
      "required": ["projection_version", "source_schema_version", "record_type", "sequence", "section_counts", "value"],
      "properties": {
        "projection_version": { "const": "svgdiff-agent-projection/1" },
        "source_schema_version": { "const": "2.0" },
        "record_type": { "const": "header" },
        "sequence": { "const": 0 },
        "section_counts": {
          "type": "object",
          "required": ["difference_groups", "events", "limitations"],
          "properties": {
            "difference_groups": { "type": "integer", "minimum": 0 },
            "events": { "type": "integer", "minimum": 0 },
            "limitations": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "value": {
          "type": "object",
          "required": ["schema_version", "analysis_status", "comparison", "canvas"],
          "properties": {
            "schema_version": { "const": "2.0" },
            "analysis_status": { "enum": ["complete", "partial", "failed"] },
            "comparison": { "type": "object" },
            "canvas": { "type": "object" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "itemRecord": {
      "type": "object",
      "required": ["projection_version", "source_schema_version", "record_type", "sequence", "section", "index", "value"],
      "properties": {
        "projection_version": { "const": "svgdiff-agent-projection/1" },
        "source_schema_version": { "const": "2.0" },
        "record_type": { "const": "item" },
        "sequence": { "type": "integer", "minimum": 1 },
        "section": { "enum": ["difference_groups", "events", "limitations"] },
        "index": { "type": "integer", "minimum": 0 },
        "value": {}
      },
      "additionalProperties": false
    }
  }
}
