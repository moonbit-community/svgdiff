{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://milky2018.github.io/svgdiff/schema/agent-projection-record-1.json",
  "title": "SVG Diff Agent projection JSONL record",
  "anyOf": [
    { "$ref": "#/$defs/headerRecord" },
    { "$ref": "#/$defs/itemRecord" }
  ],
  "$defs": {
    "sectionCounts": {
      "type": "object",
      "required": [
        "coverage_matrix",
        "renderer_capability_gaps",
        "subject_alignments",
        "changed_facts",
        "source_resolutions",
        "atomic_differences",
        "events",
        "diagnostics"
      ],
      "properties": {
        "coverage_matrix": { "type": "integer", "minimum": 0 },
        "renderer_capability_gaps": { "type": "integer", "minimum": 0 },
        "subject_alignments": { "type": "integer", "minimum": 0 },
        "changed_facts": { "type": "integer", "minimum": 0 },
        "source_resolutions": { "type": "integer", "minimum": 0 },
        "atomic_differences": { "type": "integer", "minimum": 0 },
        "events": { "type": "integer", "minimum": 0 },
        "diagnostics": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "headerValue": {
      "type": "object",
      "required": [
        "schema_version",
        "analysis_status",
        "canvas_outcome",
        "impact_assessment",
        "profile"
      ],
      "properties": {
        "schema_version": { "const": "1.45" },
        "analysis_status": { "enum": ["complete", "partial", "failed"] },
        "canvas_outcome": { "type": "object" },
        "impact_assessment": { "type": "object" },
        "profile": { "type": "object" }
      },
      "additionalProperties": false
    },
    "headerRecord": {
      "type": "object",
      "required": [
        "projection_version",
        "source_schema_version",
        "record_type",
        "sequence",
        "section_counts",
        "value"
      ],
      "properties": {
        "projection_version": { "const": "svgdiff-agent-projection/1" },
        "source_schema_version": { "const": "1.45" },
        "record_type": { "const": "header" },
        "sequence": { "const": 0 },
        "section_counts": { "$ref": "#/$defs/sectionCounts" },
        "value": { "$ref": "#/$defs/headerValue" }
      },
      "additionalProperties": false
    },
    "itemRecord": {
      "type": "object",
      "required": [
        "projection_version",
        "source_schema_version",
        "record_type",
        "sequence",
        "section",
        "index",
        "value"
      ],
      "properties": {
        "projection_version": { "const": "svgdiff-agent-projection/1" },
        "source_schema_version": { "const": "1.45" },
        "record_type": { "const": "item" },
        "sequence": { "type": "integer", "minimum": 1 },
        "section": {
          "enum": [
            "coverage_matrix",
            "renderer_capability_gaps",
            "subject_alignments",
            "changed_facts",
            "source_resolutions",
            "atomic_differences",
            "events",
            "diagnostics"
          ]
        },
        "index": { "type": "integer", "minimum": 0 },
        "value": { "type": "object" }
      },
      "additionalProperties": false
    }
  }
}
